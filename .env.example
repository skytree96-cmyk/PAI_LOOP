# Local-safe defaults. Never commit real credentials.
PAI_LOOP_ENV=development
PAI_LOOP_DATABASE_URL=sqlite:///./data/pai_loop.db
PAI_LOOP_SEED_SYNTHETIC=false
PAI_LOOP_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
PAI_LOOP_LOG_LEVEL=INFO
# Server-to-server fallback until Teams/Entra SSO and RBAC are connected.
# Required when PAI_LOOP_ENV=production. Never put this value in browser code.
PAI_LOOP_API_KEY=
# High-entropy (32+ ASCII characters) scoped credential for private company
# performance/evidence APIs. The four-digit demo PIN is never accepted here.
PAI_LOOP_PRIVATE_EVIDENCE_TOKEN=
# Contest demo only: allow a narrow set of publication-safe GET routes.
# All writes and internal/status routes still require PAI_LOOP_API_KEY.
PAI_LOOP_PUBLIC_READ_ONLY=false
# Optional public-demo BFF: same-origin PPS discovery/save, company award lookup,
# and one OPEN PPS analysis request; server credentials stay private and calls are bounded.
PAI_LOOP_PUBLIC_MANUAL_ANALYSIS_ENABLED=false
# Demo-only 4-digit operator PIN for external PPS lookup/save and paid manual analysis.
# Use exactly four ASCII digits; this remains separate from PAI_LOOP_API_KEY.
PAI_LOOP_PUBLIC_MANUAL_ANALYSIS_TOKEN=
# 0 disables the aggregate hourly quota. Duplicate/cooldown guards still apply.
PAI_LOOP_PUBLIC_MANUAL_ANALYSIS_HOURLY_LIMIT=0
PAI_LOOP_PUBLIC_MANUAL_ANALYSIS_COOLDOWN_HOURS=24
# `n8n_claude` keeps the Anthropic credential inside n8n. The webhook must
# require the same X-PAI-LOOP-API-KEY used by the backend automation.
PAI_LOOP_LLM_PROVIDER=n8n_claude
PAI_LOOP_LLM_GATEWAY_BASE_URL=https://n8n.kma.or.kr/webhook/pai-loop-claude
PAI_LOOP_CLAUDE_MODEL=claude-sonnet-5
PAI_LOOP_PPS_BASE_URL=https://apis.data.go.kr/1230000
PAI_LOOP_PPS_NOTICE_OPERATION=ad/BidPublicInfoService/getBidPblancListInfoServcPPSSrch
PAI_LOOP_PPS_AWARD_OPERATION=as/ScsbidInfoService/getScsbidListSttusServcPPSSrch

# External services are connected by n8n/credential stores, not source control.
N8N_BASE_URL=
N8N_API_KEY=
PPS_API_KEY=
